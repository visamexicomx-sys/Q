# Free LLM API Keys
# Copy this file to .env and fill in your keys
# Get all keys for free — see free-apis.md for sign-up links

# ─── Completely Free ──────────────────────────────────────────────────────────

# OpenRouter (https://openrouter.ai) — 50 req/day free, 25+ models
OPENROUTER_API_KEY=

# Google AI Studio (https://aistudio.google.com) — Gemini 2.0 Flash free
GOOGLE_API_KEY=

# Groq (https://console.groq.com) — 14,400 req/day, fastest Llama
GROQ_API_KEY=

# Cerebras (https://cloud.cerebras.ai) — 14,400 req/day, fast inference
CEREBRAS_API_KEY=

# Mistral (https://console.mistral.ai) — 1B tokens/month free
MISTRAL_API_KEY=

# Cohere (https://cohere.com) — 1,000 req/month
COHERE_API_KEY=

# NVIDIA NIM (https://build.nvidia.com) — Llama 405B, 40 req/min
NVIDIA_API_KEY=

# HuggingFace (https://huggingface.co/settings/tokens) — $0.10/month credits
HUGGINGFACE_API_KEY=

# GitHub Models (https://github.com/settings/tokens) — needs Copilot
GITHUB_TOKEN=

# Cloudflare Workers AI (https://dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# ─── Trial Credits ────────────────────────────────────────────────────────────

# SambaNova $5 (https://cloud.sambanova.ai)
SAMBANOVA_API_KEY=

# AI21 $10 (https://studio.ai21.com)
AI21_API_KEY=

# Fireworks $1 (https://fireworks.ai)
FIREWORKS_API_KEY=

# Hyperbolic $1 (https://app.hyperbolic.ai)
HYPERBOLIC_API_KEY=

# Nebius $1 (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=

# Novita $0.50 (https://novita.ai)
NOVITA_API_KEY=
