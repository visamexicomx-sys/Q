# Copy to .env and fill in. Load with: set -a; source .env; set +a
# NEVER commit the real .env (it is gitignored).

# --- Bybit API credentials (need Options + Derivatives trade permission) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Trading gates (default = safe) ---
# DRY-RUN unless BOTH BYBIT_LIVE=true AND valid credentials are present.
BYBIT_LIVE=false
# Testnet unless BYBIT_MAINNET=true. Start on testnet.
BYBIT_MAINNET=false

# --- Telegram alerts (optional) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
