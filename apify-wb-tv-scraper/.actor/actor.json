{
  "actorSpecification": 1,
  "name": "wildberries-tv-scraper",
  "title": "Wildberries TV scraper",
  "description": "Скрейпит все телевизоры с Wildberries.ru через публичный search.wb.ru API, фильтрует аксессуары, считает скидки и пишет в Key-Value Store отчёт REPORT.md с топом артикулов по цене.",
  "version": "0.1",
  "buildTag": "latest",
  "meta": { "templateId": "js-empty" },
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": [
        "id",
        "name",
        "brand",
        "diagonal",
        "price",
        "basicPrice",
        "discount",
        "rating",
        "feedbacks",
        "supplier",
        "supplierId",
        "supplierRating",
        "subjectId",
        "url"
      ],
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "id",
              "brand",
              "diagonal",
              "name",
              "price",
              "discount",
              "rating",
              "feedbacks",
              "supplier",
              "supplierRating",
              "url"
            ]
          },
          "display": { "component": "table" }
        }
      }
    }
  }
}
