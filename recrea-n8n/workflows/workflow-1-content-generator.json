          "id": "YOUR_GOOGLE_CRED_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=🤖 *RECREA Content Farm*\n\n✅ Nueva caption generada y lista para revisión:\n\n*Topic:* {{ $('Code: Parse Claude Response').first().json.topic }}\n*Type:* {{ $('Code: Parse Claude Response').first().json.postType }}\n*Hook:* {{ $('Code: Parse Claude Response').first().json.hook }}\n*Chars:* {{ $('Code: Parse Claude Response').first().json.charCount }}\n*Hashtags:* {{ $('Code: Parse Claude Response').first().json.hashtagCount }}\n\n👉 Revisa y aprueba en Google Sheets → Content Queue\n\nCambia el status a *approved* cuando esté lista para publicar.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000008",
