    {
      "parameters": {
        "jsCode": "// Summarize today's engagement activity\nconst rows = $input.all().map(i => i.json);\nconst today = new Date().toISOString().split('T')[0];\n\nconst totalActions = rows.length;\nconst hashtagsUsed = [...new Set(rows.map(r => r.Hashtag))].join(', ');\nconst commentsPosted = rows.filter(r => r['Comment Text']).length;\n\nreturn [\n  {\n    json: {\n      date: today,\n      totalActions,\n      hashtagsUsed,\n      commentsPosted,\n      likesGiven: totalActions\n    }\n  }\n];"
      },
