{
  "name": "RECREA — 4. Daily Engagement Bot",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 10,
              "triggerAtMinute": 30,
              "weekdays": [1, 2, 3, 4, 5]
